{
  "apiVersion": "1.0",
  "id": "field-tools",
  "version": "1.0.0",
  "name": "Field Tools",
  "author": "WarLike Community",
  "description": "Deux interactions communautaires pour les prototypes RP et aventure.",
  "recipes": [
