        "event": "interact",
        "radius": 125,
        "key": "e",
        "once": false,
        "conditions": [],
        "instructions": [
          {
            "type": "addVariable",
            "key": "reputation",
            "value": 1
          },
          {
            "type": "message",
            "value": "Bienvenue, voyageur ! Réputation +1."
          }
        ]
      }
    },
    {
      "id": "supply-cache",
      "name": "Réserve de provisions",
      "description": "Donne une provision une seule fois",
      "sequence": {
        "event": "interact",
        "radius": 100,
        "key": "e",
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "giveItem",
            "targetRole": "player",
            "key": "supplies",
            "value": 1
          },
          {
            "type": "message",
            "value": "Provisions récupérées."
          }
        ]
      }
    }
  ]
