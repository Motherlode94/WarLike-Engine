      "sequence": {
        "event": "interact",
        "radius": 100,
        "key": "e",
        "once": false,
        "conditions": [],
        "instructions": [
          {
            "type": "addVariable",
            "key": "npcInteractions",
            "value": 1
          },
          {
            "type": "message",
            "value": "Le village a besoin de ton aide !"
          }
        ]
      }
    },
    {
      "id": "arcade-goal",
