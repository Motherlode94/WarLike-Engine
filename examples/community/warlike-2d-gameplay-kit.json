{
  "apiVersion": "1.0",
  "id": "warlike-2d-gameplay-kit",
  "version": "1.0.0",
  "name": "WarLike 2D Gameplay Kit",
  "author": "WarLike Studio",
  "description": "Recettes Blueprint pour plateformes, RPG 2D et arcade : collectibles, checkpoints, quetes et portes de progression.",
  "modes": [
    "2d"
  ],
  "recipes": [
    {
      "id": "collect-coin",
