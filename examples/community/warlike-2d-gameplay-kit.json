      "sequence": {
        "event": "interact",
        "radius": 75,
        "key": "e",
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "giveItem",
            "targetRole": "player",
            "key": "coin",
            "value": 1
          },
          {
            "type": "addVariable",
            "key": "coinsCollected",
            "value": 1
          },
          {
            "type": "message",
            "value": "+1 piece collectee"
          }
        ]
      }
    },
    {
      "id": "activate-checkpoint",
      "name": "Checkpoint 2D",
      "description": "Enregistre une progression de niveau (variable logique, sans teleportation).",
      "sequence": {
        "event": "interact",
        "radius": 85,
        "key": "e",
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "addVariable",
            "key": "checkpointsReached",
            "value": 1
          },
          {
            "type": "message",
            "value": "Checkpoint active !"
          }
        ]
      }
    },
    {
