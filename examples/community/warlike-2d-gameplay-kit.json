      "description": "Signale la sortie et augmente le compteur des objectifs.",
      "sequence": {
        "event": "interact",
        "radius": 95,
        "key": "e",
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "addVariable",
            "key": "arcadeGoals",
            "value": 1
          },
          {
            "type": "message",
            "value": "Objectif atteint !"
          }
        ]
