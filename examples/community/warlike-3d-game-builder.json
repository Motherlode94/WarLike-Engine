{
  "apiVersion": "1.0",
  "id": "warlike-3d-game-builder",
  "version": "1.0.0",
  "name": "Game Builder 3D • FPS, TPS, RPG et exploration",
  "author": "WarLike Studio",
  "modes": [
    "3d"
  ],
  "description": "Blueprints de construction declaratifs pour scenes 3D. Appliquer chaque recette a un objet de la scene.",
  "recipes": [
    {
      "id": "mission-terminal",
      "name": "Mission Terminal",
      "description": "Interaction preconfiguree : Mission Terminal",
      "sequence": {
        "event": "interact",
        "key": "e",
        "radius": 125,
        "once": true,
        "interval": 5,
        "conditions": [],
        "instructions": [
          {
            "type": "setVariable",
            "key": "missionActive",
            "value": 1
          },
          {
            "type": "message",
            "value": "Mission commencee"
          }
        ]
      }
    },
    {
      "id": "mission-item",
      "name": "Objective Pickup",
      "description": "Interaction preconfiguree : Objective Pickup",
      "sequence": {
        "event": "interact",
        "key": "e",
        "radius": 125,
        "once": true,
        "interval": 5,
        "conditions": [],
        "instructions": [
          {
            "type": "giveItem",
            "targetRole": "player",
            "key": "intel",
            "value": 1
          },
          {
            "type": "addVariable",
            "key": "intelCollected",
            "value": 1
          },
          {
            "type": "message",
            "value": "Information acquise"
          }
        ]
      }
    },
    {
      "id": "mission-extraction",
      "name": "Extraction Zone",
      "description": "Interaction preconfiguree : Extraction Zone",
      "sequence": {
        "event": "interact",
        "key": "e",
        "radius": 125,
        "once": true,
        "interval": 5,
        "conditions": [
          {
            "type": "variable",
            "key": "intelCollected",
            "operator": ">=",
            "value": 1
          }
        ],
        "instructions": [
          {
            "type": "setVariable",
            "key": "missionComplete",
            "value": 1
          },
          {
            "type": "emitSignal",
            "value": "mission:complete"
          },
          {
            "type": "message",
            "value": "Extraction reussie"
          }
        ]
      }
    },
    {
