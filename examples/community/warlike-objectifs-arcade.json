{
  "apiVersion": "1.0",
  "id": "warlike-objectifs-arcade",
  "version": "1.0.0",
  "name": "Objectifs arcade",
  "author": "WarLike Studio",
  "modes": [
    "2d",
    "3d"
  ],
  "description": "Des pièces, un point de reprise et une sortie conditionnelle pour une courte scène.",
  "recipes": [
    {
      "id": "piece",
      "name": "Pièce à collecter",
      "description": "Ajoute une pièce une seule fois.",
      "sequence": {
        "event": "enter",
        "key": "e",
        "radius": 130,
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "addVariable",
            "key": "arcadePieces",
            "value": 1
          },
          {
            "type": "setVisibility",
            "value": false
          },
          {
            "type": "message",
            "value": "Pièce récupérée !"
          }
        ]
      }
    },
    {
      "id": "checkpoint",
      "name": "Point de reprise",
      "description": "Enregistre un point de reprise lorsque le joueur le traverse.",
      "sequence": {
        "event": "enter",
        "key": "e",
        "radius": 130,
        "once": true,
        "conditions": [],
        "instructions": [
          {
            "type": "setCheckpoint"
          },
          {
            "type": "message",
            "value": "Point de reprise activé."
          }
        ]
      }
    },
    {
      "id": "sortie",
      "name": "Sortie à trois pièces",
      "description": "Gagne uniquement lorsque trois pièces ont été récupérées.",
      "sequence": {
        "event": "interact",
        "key": "e",
        "radius": 130,
        "once": false,
        "branches": [
          {
            "conditions": [
              {
                "type": "variable",
                "key": "arcadePieces",
                "value": 3,
                "operator": ">="
              }
            ],
            "instructions": [
              {
                "type": "winGame",
                "value": "Trois pièces récupérées : victoire !"
              }
            ]
          }
        ],
        "elseInstructions": [
          {
            "type": "message",
            "value": "Récupère trois pièces pour sortir."
          }
        ]
      }
    },
    {
      "id": "indice",
      "name": "Panneau des règles",
      "description": "Présente l’objectif de la scène.",
      "sequence": {
        "event": "interact",
        "key": "e",
        "radius": 130,
        "once": false,
        "conditions": [],
        "instructions": [
          {
            "type": "message",
            "value": "Récupère trois pièces, puis rejoins la sortie."
          }
        ]
      }
    }
  ]
}
