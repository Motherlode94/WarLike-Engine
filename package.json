{
  "name": "warlike-studio",
  "private": true,
  "version": "3.0.0-beta.8",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test:types": "npm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "build:runtime": "node scripts/build-runtime-manifest.mjs",
    "test:native": "dotnet run --project csharp/WarLike.Tests",
    "bench:wasm": "node scripts/bench-native-queries.mjs",
    "check:wasm": "node --test tests/native-3d-wasm.test.mjs",
    "test:export": "node scripts/export-validation-game.mjs && node scripts/test-exported-game.mjs",
    "test:export:browser": "node scripts/test-exported-game-browser.mjs",
    "test:chambre07:export": "node --test tests/chambre-07-export-readiness.test.mjs",
    "test:chambre07:browser": "node scripts/test-chambre07-export-browser.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "phaser": "4.2.1",
    "three": "0.186.1"
  }
}
